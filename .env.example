# Copy to .env.local (git-ignored) to talk to a model in `pnpm dev` without entering it on the page.
# Any endpoint that speaks the Anthropic Messages format works. Settings entered on the page win.
# Variables already exported in your shell win over this file (Vite behaviour).

# For example https://api.deepseek.com/anthropic, https://dashscope.aliyuncs.com/apps/anthropic,
# https://open.bigmodel.cn/api/anthropic, https://ark.cn-beijing.volces.com/api/compatible
# or https://api.anthropic.com
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional: on to let the model reason before answering (slower). The page switch overrides it.
AI_THINKING=

# Optional, defaults to 16000. Thinking counts toward this limit.
AI_MAX_TOKENS=
