# Copy to .env.local (git-ignored) to talk to a real model in `pnpm dev`.
# Set one of the keys below. If both are set, choose with AI_PROVIDER=anthropic|deepseek.
# Variables already exported in your shell win over this file (Vite behaviour).

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=
# Optional, for an Anthropic-compatible gateway
ANTHROPIC_BASE_URL=

# DeepSeek (through its Anthropic-compatible endpoint)
DEEPSEEK_API_KEY=
# Optional, defaults to deepseek-flash (or deepseek-v4-pro)
DEEPSEEK_MODEL=

AI_PROVIDER=

# Optional, defaults to 16000. Thinking counts toward this limit.
AI_MAX_TOKENS=
